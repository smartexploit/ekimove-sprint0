APP_NAME=EkiMove API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ekimove_app:replace_with_your_password@127.0.0.1:5432/ekimove

# Generate a separate strong secret for each deployed environment.
JWT_SECRET_KEY=replace_with_a_long_random_secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Optionally use a hosted Redis URL (redis:// or rediss://).
# Keep credentials out of source control; set the URL privately in deployment.
REDIS_URL=

# Alternatively, configure the individual connection settings below.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=true

# Business details shown to passengers. Fill these in once confirmed;
# until then the app tells passengers the details are not yet available.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# Interswitch checkout: configure these with values confirmed by your team.
# Never commit private credentials. TEST mode is the default.
INTERSWITCH_MERCHANT_CODE=
INTERSWITCH_PAY_ITEM_ID=
INTERSWITCH_MODE=TEST
INTERSWITCH_REQUERY_BASE_URL=https://sandbox.interswitchng.com/collections/api/v1/gettransaction.json

# Instant transfers (Paystack dedicated virtual accounts).
# Each passenger gets a personal account number; transfers to it confirm
# rides automatically. Off until PAYSTACK_SECRET_KEY is set. Point the
# Paystack dashboard webhook at https://<api>/api/v1/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
# test-bank with sk_test keys; wema-bank or titan-paystack live.
PAYSTACK_PREFERRED_BANK=wema-bank
# false until Paystack enables Dedicated Virtual Accounts for EkiMove;
# passengers then pay into BANK_TRANSFER_* and admins confirm.
PAYSTACK_VIRTUAL_ACCOUNTS_ENABLED=true
PAYSTACK_CUSTOMER_EMAIL_DOMAIN=passengers.ekimove.app

# Cancellations: free before assignment and for this many seconds after;
# later cancellations of a paid ride keep this fee (NGN) and refund the rest.
CANCELLATION_FREE_SECONDS=120
CANCELLATION_FEE_MOTORCYCLE=200
CANCELLATION_FEE_CAR=500

# Driver earnings and payouts.
# EkiMove keeps this % of each fare and kept cancellation fee.
COMMISSION_PERCENT=10
# Balances below this (NGN) wait for the next payout run.
PAYOUT_MINIMUM=500
# true = send payouts automatically with Paystack Transfers (needs
# PAYSTACK_SECRET_KEY, transfers enabled and transfer OTP turned off).
# false = payouts are queued for staff to send and mark as sent.
PAYSTACK_TRANSFERS_ENABLED=false
# Secret for the daily payout job (POST /api/v1/internal/payouts/run with
# header X-Cron-Token). Leave empty to disable that endpoint.
PAYOUT_CRON_TOKEN=

# Atọ́nà AI booking assistant
# Open to everyone; account answers ask guests to sign in.
ATONA_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Messages per window per signed-in account / per guest IP address.
ATONA_USER_MESSAGE_LIMIT=40
ATONA_GUEST_MESSAGE_LIMIT=20
ATONA_RATE_LIMIT_WINDOW_SECONDS=600
# Optional: lets Atọ́nà check landmarks and estimate driving routes.
GEOAPIFY_API_KEY=

# Text messages for sign-up codes and password resets (off until set).
# Recommended: bulksmsnigeria (about NGN 6.49 per text, DND included).
SMS_PROVIDER=
SMS_SENDER_ID=EkiMove
BULKSMS_API_TOKEN=
# Or Termii: SMS_PROVIDER=termii plus the key and the base URL shown on
# your Termii dashboard.
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
# Most code texts in any 24 hours (caps cost if sign-up is abused).
SMS_DAILY_LIMIT=300

# Email for codes (optional). brevo uses an HTTPS API, which works on
# Render's free plan (it blocks SMTP); smtp works on paid plans.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EkiMove
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false

# Phone notifications. Keys are generated automatically; set these only
# to use your own VAPID pair.
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional error monitoring.
SENTRY_DSN=

# Public address of the app (used in links sent by text, e.g. delivery tracking).
FRONTEND_URL=https://ekimove.onrender.com

# In-app calls (optional relay for networks that block direct connections)
CALLS_ENABLED=true
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Website "Publish" button: the static site Deploy Hook
RENDER_DEPLOY_HOOK_URL=
