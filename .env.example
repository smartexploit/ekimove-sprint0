APP_NAME=EkiMove API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ekimove_app:replace_with_your_password@127.0.0.1:5432/ekimove

# Generate a separate strong secret for each deployed environment.
JWT_SECRET_KEY=replace_with_a_long_random_secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Optionally use a hosted Redis URL (redis:// or rediss://).
# Keep credentials out of source control; set the URL privately in deployment.
REDIS_URL=

# Alternatively, configure the individual connection settings below.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=true

# Business details shown to passengers. Fill these in once confirmed;
# until then the app tells passengers the details are not yet available.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# Interswitch checkout: configure these with values confirmed by your team.
# Never commit private credentials. TEST mode is the default.
INTERSWITCH_MERCHANT_CODE=
INTERSWITCH_PAY_ITEM_ID=
INTERSWITCH_MODE=TEST
INTERSWITCH_REQUERY_BASE_URL=https://sandbox.interswitchng.com/collections/api/v1/gettransaction.json

# Instant transfers (Paystack dedicated virtual accounts).
# Each passenger gets a personal account number; transfers to it confirm
# rides automatically. Off until PAYSTACK_SECRET_KEY is set. Point the
# Paystack dashboard webhook at https://<api>/api/v1/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
# test-bank with sk_test keys; wema-bank or titan-paystack live.
PAYSTACK_PREFERRED_BANK=wema-bank
PAYSTACK_CUSTOMER_EMAIL_DOMAIN=passengers.ekimove.app

# Cancellations: free before assignment and for this many seconds after;
# later cancellations of a paid ride keep this fee (NGN) and refund the rest.
CANCELLATION_FREE_SECONDS=120
CANCELLATION_FEE_MOTORCYCLE=200
CANCELLATION_FEE_CAR=500

# Atọ́nà AI booking assistant
# Open to everyone; account answers ask guests to sign in.
ATONA_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Messages per window per signed-in account / per guest IP address.
ATONA_USER_MESSAGE_LIMIT=40
ATONA_GUEST_MESSAGE_LIMIT=20
ATONA_RATE_LIMIT_WINDOW_SECONDS=600
# Optional: lets Atọ́nà check landmarks and estimate driving routes.
GEOAPIFY_API_KEY=
